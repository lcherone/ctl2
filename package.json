{
  "name": "@lcherone/ctl2",
  "version": "0.2.0",
  "description": "Deterministic, reversible Compact Task Language serialization for structured AI handovers.",
  "license": "MIT",
  "author": "Lawrence Cherone",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "SECURITY.md",
    "SUPPORT.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lcherone/ctl2.git"
  },
  "bugs": {
    "url": "https://github.com/lcherone/ctl2/issues"
  },
  "homepage": "https://github.com/lcherone/ctl2#readme",
  "keywords": [
    "ai",
    "codec",
    "compact",
    "deterministic",
    "handover",
    "serialization",
    "task"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --treeshake --target es2020",
    "check": "npm run lint && npm run lint:docs && npm run typecheck && npm run docs:check && npm run test:coverage && npm run build && npm run test:types && npm run test:package && npm run package:check && npm run test:tarball",
    "docs:check": "typedoc --options typedoc.json --emit none",
    "lint": "eslint .",
    "lint:docs": "node scripts/check-docs.mjs",
    "package:check": "publint",
    "prepack": "npm run check",
    "release:check": "node scripts/check-release-tag.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:package": "node --test test/*.test.mjs",
    "test:tarball": "node scripts/test-tarball.mjs",
    "test:types": "tsc --project test/consumer/tsconfig.json --noEmit",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^10.0.1",
    "eslint-plugin-jsdoc": "^65.3.11",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typedoc": "^0.28.20",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "4.1.12"
  },
  "packageManager": "npm@11.21.1",
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
